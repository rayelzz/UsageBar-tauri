{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UsageBar",
  "version": "0.0.21",
  "identifier": "com.rayel.usagebar",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "bar",
        "title": "UsageBar",
        "url": "index.html?w=bar",
        "width": 46,
        "height": 236,
        "minWidth": 1,
        "minHeight": 1,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "focusable": false
      },
      {
        "label": "tip",
        "title": "UsageBar Tip",
        "url": "index.html?w=tip",
        "width": 340,
        "height": 220,
        "minWidth": 1,
        "minHeight": 1,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "focusable": false
      },
      {
        "label": "settings",
        "title": "Providers",
        "url": "index.html?w=settings",
        "width": 420,
        "height": 680,
        "minWidth": 360,
        "minHeight": 420,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "shadow": true,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "visible": false,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#141416"
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true,
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENFN0I4MjY2QTg4OERDMTAKUldRUTNJaW9ab0o3em5VdDBFdFYrOEF0a1d6dnJVSUkzWTBjc0RCQnVvQ3BiMUpyWFpDRzE4U3UK",
      "endpoints": [
        "https://github.com/rayelzz/UsageBar-tauri/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
